{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "dev.mikanseilaboratory.bmd.hyperdeck.dial-jog",
  "items": [
    {
      "key": "title",
      "type": "text",
      "rect": [8, 2, 184, 16],
      "font": { "size": 11, "weight": 500 },
      "alignment": "left"
    },
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [8, 22, 32, 32]
    },
    {
      "key": "value",
      "type": "text",
      "rect": [44, 18, 148, 20],
      "font": { "size": 14, "weight": 600 },
      "alignment": "right"
    },
    {
      "key": "remaining",
      "type": "text",
      "rect": [44, 40, 148, 18],
      "font": { "size": 13, "weight": 500 },
      "alignment": "right"
    },
    {
      "key": "indicator",
      "type": "bar",
      "rect": [44, 64, 148, 8],
      "value": 0,
      "subtype": 4,
      "border_w": 0
    }
  ]
}
